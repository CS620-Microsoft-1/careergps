# Copy this file to .env and fill in the real values. Never commit .env.
# Supabase → Connect → Session pooler (port 5432). Use the database password, not your Supabase login.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Supabase project URL, used to verify login tokens: Supabase → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only if the project still uses the legacy JWT secret (HS256). Leave unset with JWT signing keys.
# SUPABASE_JWT_SECRET=<legacy-jwt-secret>

# Existing Microsoft Foundry Agent. Do not put credentials in this file.
# Local development authenticates through `az login`.
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_AGENT_NAME=<existing-agent-name>

# Skill Gap evidence Agent. The authenticated API reads the saved database resume;
# analysis results remain local JSON. No separate result database is required.
SKILL_GAP_FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
SKILL_GAP_FOUNDRY_AGENT_NAME=<skill-gap-agent-name>

# Separate endpoint for JD extraction; code pins job-analysis-agent version 13.
# These settings do not update the deployed Agent or affect resume classification.
JOB_ANALYSIS_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
JOB_ANALYSIS_TIMEOUT_SECONDS=600

# Server-only token for POST /job-postings/{id}/analyze; blank disables submissions.
# Choose a private random token locally. Never expose it in frontend environment variables.
JOB_ANALYSIS_ADMIN_TOKEN=

# Base directory for local-only queue and 28-field JSON. Relative to backend/.
# The pipeline always adds /v13; do not append it here. Older caches remain untouched.
JOB_ANALYSIS_LOCAL_DIR=local_exports/job_analyses

# Certification recommendation Agent. Optional: when unset, the Resources page ranks
# certifications from backend/data/certifications.json by skill gap priority instead.
CERTIFICATION_FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
CERTIFICATION_FOUNDRY_AGENT_NAME=<certification-agent-name>
