# Copy this file to .env and fill in the real values. Never commit .env.
# Supabase → Connect → Session pooler (port 5432). Use the database password, not your Supabase login.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
