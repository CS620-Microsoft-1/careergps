      "task",
      "result"
    ],
    "additionalProperties": false,
    "$defs": {
      "Proof": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "description": "Shortest sufficient exact contiguous original fragment."
          }
        },
        "required": [
          "unit_id",
          "quote"
        ],
        "additionalProperties": false
      },
      "Capability": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string",
            "enum": [
              "direct_personal",
              "related_context",
              "unclear",
              "other_person"
            ]
          },
          "quote": {
            "type": "string",
            "description": "Exact core-defining mechanism within operation_id. Using/testing a component does not establish its internal algorithm or design."
          }
        },
        "required": [
          "relation",
          "quote"
        ],
        "additionalProperties": false
      },
      "Method": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "named_method",
              "mechanism_described",
              "rationale_explained"
            ]
          },
          "proof": {
            "$ref": "#/$defs/Proof"
          }
        },
        "required": [
          "kind",
          "proof"
        ],
        "additionalProperties": false
      },
      "Validation": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "check_only",
              "workflow_only",
              "unclear",
              "observed",
              "compared"
            ]
          },
          "check": {
            "$ref": "#/$defs/Proof"
          },
          "finding": {
            "anyOf": [
              {
                "$ref": "#/$defs/Proof"
              },
              {
                "type": "null"
              }
            ],
            "description": "A reported observation: 'checked correctness' is check-only; 'checks found no violations' supplies a finding."
          },
          "finding_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "measured_value",
              "observed_state",
              "diagnosed_cause",
              "relative_difference",
              "repeat_consistency",
              null
            ]
          },
          "reference": {
            "anyOf": [
              {
                "$ref": "#/$defs/Proof"
              },
              {
                "type": "null"
              }
            ]
          },
          "reported_value": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact literal numeric result within finding.quote for measured_value only; otherwise null."
          },
          "relation": {
            "type": "string",
            "enum": [
              "same_capability",
              "other_or_unclear"
            ]
          }
        },
        "required": [
          "kind",
          "check",
          "finding",
          "finding_type",
          "reference",
          "reported_value",
          "relation"
        ],
        "additionalProperties": false
      },
      "Absent": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
