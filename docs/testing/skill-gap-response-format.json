{
  "name": "careergps_pipeline_response",
  "strict": true,
  "schema": {
    "$defs": {
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "quote": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "listed",
              "applied",
              "validated"
            ],
            "type": "string"
          }
        },
        "required": [
          "path",
          "quote",
          "kind"
        ],
        "type": "object"
      },
      "Condition": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/JobEvidence"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "type",
          "value",
          "evidence"
        ],
        "type": "object"
      },
      "Confirmation": {
        "additionalProperties": false,
        "properties": {
          "condition_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "needs_confirmation",
              "supported",
              "not_evidenced",
              "partial"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "condition_id",
          "status",
          "reason"
        ],
        "type": "object"
      },
      "Criterion": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "level": {
            "enum": [
              "required",
              "preferred"
            ],
            "type": "string"
          },
          "requirement_logic": {
            "enum": [
              "single",
              "any_of",
              "all_of"
            ],
            "type": "string"
          },
          "example_options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "examples_exhaustive": {
            "type": "boolean"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/JobEvidence"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "name",
          "categories",
          "level",
          "requirement_logic",
          "example_options",
          "examples_exhaustive",
          "evidence"
        ],
        "type": "object"
      },
      "Demand": {
        "additionalProperties": false,
        "properties": {
          "required_postings": {
            "type": "integer"
          },
          "preferred_only_postings": {
            "type": "integer"
          },
          "required_ratio": {
            "type": "number"
          },
          "preferred_only_ratio": {
            "type": "number"
          },
          "combined_ratio": {
            "type": "number"
          }
        },
        "required": [
          "required_postings",
          "preferred_only_postings",
          "required_ratio",
          "preferred_only_ratio",
          "combined_ratio"
        ],
        "type": "object"
      },
      "FinalCondition": {
        "additionalProperties": false,
        "properties": {
          "condition_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "needs_confirmation",
              "supported",
              "not_evidenced",
              "partial"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "condition_id",
          "status",
          "reason",
          "type",
          "value"
        ],
        "type": "object"
      },
      "FinalCriterion": {
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "requirement_logic": {
            "enum": [
              "single",
              "any_of",
              "all_of"
            ],
            "type": "string"
          },
          "example_options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "examples_exhaustive": {
            "type": "boolean"
          },
          "demand": {
            "$ref": "#/$defs/Demand"
          },
          "resume_match": {
            "$ref": "#/$defs/ResumeMatch"
          },
          "gap": {
            "$ref": "#/$defs/Gap"
          },
          "recommended_action": {
            "type": "string"
          },
          "completion_evidence": {
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "name",
          "categories",
          "requirement_logic",
          "example_options",
          "examples_exhaustive",
          "demand",
          "resume_match",
          "gap",
          "recommended_action",
          "completion_evidence"
        ],
        "type": "object"
      },
      "FinalOutput": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/Target"
          },
          "market": {
            "$ref": "#/$defs/Market"
          },
          "summary": {
            "type": "string"
          },
          "criteria": {
            "items": {
              "$ref": "#/$defs/FinalCriterion"
            },
            "type": "array"
          },
          "conditions_to_confirm": {
            "items": {
              "$ref": "#/$defs/FinalCondition"
            },
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "mode",
          "target",
          "market",
          "summary",
          "criteria",
          "conditions_to_confirm",
          "limitations"
        ],
        "type": "object"
      },
      "FinalResponse": {
        "additionalProperties": false,
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "explain_skill_gaps"
            ]
          },
          "data": {
            "$ref": "#/$defs/FinalOutput"
          }
        },
        "required": [
          "task",
          "data"
        ],
        "type": "object"
      },
      "Gap": {
        "additionalProperties": false,
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "anyOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "score",
          "priority",
          "reason"
        ],
        "type": "object"
      },
      "JobEvidence": {
        "additionalProperties": false,
        "properties": {
          "source_path": {
            "type": "string"
          },
          "source_field": {
            "type": "string"
          },
          "quote": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_path",
          "source_field",
          "quote"
        ],
        "type": "object"
      },
      "JobResponse": {
        "additionalProperties": false,
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "extract_job_requirements"
            ]
          },
          "data": {
            "$ref": "#/$defs/JobsOutput"
          }
        },
        "required": [
          "task",
          "data"
        ],
        "type": "object"
      },
      "JobsOutput": {
        "additionalProperties": false,
        "properties": {
          "postings": {
            "items": {
              "$ref": "#/$defs/PostingExtraction"
            },
            "type": "array"
          }
        },
        "required": [
          "postings"
        ],
        "type": "object"
      },
      "Market": {
        "additionalProperties": false,
        "properties": {
          "sample_size": {
            "type": "integer"
          },
          "company_count": {
            "type": "integer"
          },
          "low_confidence": {
            "type": "boolean"
          }
        },
        "required": [
          "sample_size",
          "company_count",
          "low_confidence"
        ],
        "type": "object"
      },
      "Match": {
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "partial",
              "not_evidenced",
              "needs_confirmation"
            ],
            "type": "string"
          },
          "matched_options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "type": "array"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "status",
          "matched_options",
          "evidence",
          "explanation"
        ],
        "type": "object"
      },
      "PostingExtraction": {
        "additionalProperties": false,
        "properties": {
          "posting_id": {
            "type": "string"
          },
          "criteria": {
            "items": {
              "$ref": "#/$defs/Criterion"
            },
            "type": "array"
          },
          "responsibilities": {
            "items": {
              "$ref": "#/$defs/Responsibility"
            },
            "type": "array"
          },
          "job_conditions": {
            "items": {
              "$ref": "#/$defs/Condition"
            },
            "type": "array"
          }
        },
        "required": [
          "posting_id",
          "criteria",
          "responsibilities",
          "job_conditions"
        ],
        "type": "object"
      },
      "Responsibility": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/JobEvidence"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "description",
          "evidence"
        ],
        "type": "object"
      },
      "ResumeMatch": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "supported",
              "partial",
              "not_evidenced",
              "needs_confirmation"
            ],
            "type": "string"
          },
          "matched_options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "evidence_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "type": "array"
          }
        },
        "required": [
          "status",
          "matched_options",
          "evidence_score",
          "evidence"
        ],
        "type": "object"
      },
      "ResumeOutput": {
        "additionalProperties": false,
        "properties": {
          "criteria": {
            "items": {
              "$ref": "#/$defs/Match"
            },
            "type": "array"
          },
          "conditions_to_confirm": {
            "items": {
              "$ref": "#/$defs/Confirmation"
            },
            "type": "array"
          }
        },
        "required": [
          "criteria",
          "conditions_to_confirm"
        ],
        "type": "object"
      },
      "ResumeResponse": {
        "additionalProperties": false,
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "extract_resume_evidence"
            ]
          },
          "data": {
            "$ref": "#/$defs/ResumeOutput"
          }
        },
        "required": [
          "task",
          "data"
        ],
        "type": "object"
      },
      "Target": {
        "additionalProperties": false,
        "properties": {
          "job_family": {
            "type": "string"
          },
          "seniority": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        },
        "required": [
          "job_family",
          "seniority",
          "country"
        ],
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "response": {
        "anyOf": [
          {
            "$ref": "#/$defs/JobResponse"
          },
          {
            "$ref": "#/$defs/ResumeResponse"
          },
          {
            "$ref": "#/$defs/FinalResponse"
          }
        ]
      }
    },
    "required": [
      "response"
    ],
    "type": "object"
  }
}
