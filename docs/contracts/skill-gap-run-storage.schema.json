  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "report": {
            "$ref": "#/$defs/Report"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "phase": {
            "const": "completed"
          },
          "error": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "report": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "running"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "error_code": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "const": "failed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "queued"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "queued"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "enum": [
              "preparing",
              "agent",
              "checking"
            ]
          }
        }
      }
    }
  ]
}
