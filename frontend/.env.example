# Copy this file to .env.local and adjust. Never commit .env.local.
#
# Where the FastAPI backend runs. NEXT_PUBLIC_ values are built into the browser code,
# so anyone can read them: never put secrets in a NEXT_PUBLIC_ variable.
# Restart `npm run dev` after changing this.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth: Supabase → Settings → API Keys. The publishable key is meant to be public;
# never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
